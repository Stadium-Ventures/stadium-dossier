# Supabase — Player Insights project
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxx

# ── Registry performance projection (pq-059) ───────────────────────────────
# Bearer the SV Registry presents to GET /api/registry-projection/<slug>, and
# the token this app presents on its read-duty call to sv-registry's brain API.
# Registry-minted service token (svt_…) — value from BE; never commit it.
# UNSET ⇒ the projection door answers 503 and stays closed (fails closed).
SV_REGISTRY_SERVICE_TOKEN=
# Optional override; defaults to https://sv-registry.vercel.app
SV_REGISTRY_BASE_URL=

# Server-side READ of dossier_submissions for that same door. The browser's
# anon key above is insert-only by RLS and cannot read submissions back, so
# the door needs its own credentials — and stays dark (503) without them.
# ⚠ Provisioning a service-role key in this project is a change to this app's
# security posture: BE's decision, not a session's. Server-only, NO VITE_
# prefix (that prefix is what lets Vite inline a value into the browser).
DOSSIER_SUPABASE_URL=
DOSSIER_SUPABASE_SERVICE_KEY=
